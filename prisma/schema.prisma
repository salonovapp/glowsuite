datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DemoLead {
  id         BigInt   @id @default(autoincrement())
  name       String   @db.VarChar(150)
  email      String   @db.VarChar(255)
  phone      String   @db.VarChar(30)
  salon_name String   @db.VarChar(255)
  state      String   @db.VarChar(100)
  district   String   @db.VarChar(150)
  status     String   @default("new") @db.VarChar(50)
  notes      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("demo_leads")
}

model GoogleCalendarConnection {
  id                    String   @id @default(cuid())
  provider              String   @unique
  calendarId            String
  refreshTokenEncrypted String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("GoogleCalendarConnection")
}

model DemoBooking {
  id             String   @id @default(cuid())
  leadId         BigInt?
  date           String   @db.VarChar(10)
  time           String   @db.VarChar(10)
  slotStart      DateTime @db.Timestamptz(6)
  slotEnd        DateTime @db.Timestamptz(6)
  googleEventId  String   @unique @db.VarChar(255)
  googleMeetUrl  String   @db.Text
  idempotencyKey String   @unique @db.VarChar(255)
  status              String    @default("confirmed") @db.VarChar(50)
  customerEmailSentAt DateTime? @db.Timestamptz(6)
  customerEmailId     String?   @db.VarChar(100)
  internalEmailSentAt DateTime? @db.Timestamptz(6)
  internalEmailId     String?   @db.VarChar(100)
  createdAt           DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([date, time])
  @@map("demo_bookings")
}
